# Server
PORT=3500

# Database — local MySQL for now; for a cloud database set DB_HOST/credentials and DB_SSL=true.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sp3digital_notifications
DB_USER=root
DB_PASSWORD=RosesAreRed@c1312
DB_SSL=false
# DB_SSL_CA=

# Auth — MUST be the exact same values identity-admin-service signs with and
# organization-admin-service verifies with. This service only ever verifies
# tokens minted by identity-admin-service; it never signs its own.
# ADMIN_JWT_SECRET=organization-appointment-admin-secret
ADMIN_JWT_ISSUER=http://localhost:3000
ADMIN_JWT_AUDIENCE=sp3-identity-admin
# Only needed if ADMIN_JWT_SECRET is unset (RS256/JWKS verification instead
# of a shared HS256 secret) — see src/middleware/authentication.js.
ADMIN_JWKS_URL=http://localhost:3000/.well-known/jwks.json

# CORS — comma-separated list of allowed origins. Falls back to permissive
# (dev-only) when unset.
ALLOWED_ORIGINS=http://localhost:4300,http://localhost:4200


# Shared secret the OTHER services present when they send notifications on a tenant's behalf
# (with an X-Tenant-Uuid header). Give each calling service the same value, keep it server-side only.
NOTIFICATION_SERVICE_INTERNAL_TOKEN=cvLLdJv2EV1ZvA5NM1Jr5CY1WfzUc-CN8bs8m4El39nW7a1t8pewr4SfgSjvz1wr

# --- Email -------------------------------------------------------------------------
# smtp = really send; log = print to the console, nothing leaves the machine (local development)
EMAIL_TRANSPORT=log
# The platform's own mail account, used by tenants that have not set up their own.
SMTP_SECURE=false
MAIL_FROM_ADDRESS=contact@sp3digital.com
MAIL_FROM_NAME=SP3 Digital
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=contact@sp3digital.com
SMTP_PASSWORD=Sp3Digital@c1312

# 32 random bytes, base64 (generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))").
# Encrypts the SMTP passwords tenants store. Without it tenants cannot save their own SMTP settings.
NOTIFICATION_ENCRYPTION_KEY=4aVQGydo45cmezpIo9/AQhrHFPJdp73ucT/f9IFgBnc=

# --- Delivery worker ---------------------------------------------------------------
# The API process also runs the delivery loop. Set to false to run it separately with `npm run worker`.
NOTIFICATION_WORKER=true
WORKER_INTERVAL_SECONDS=5
WORKER_BATCH_SIZE=25
# Attempts before a notification is marked FAILED (retried after 1 min, 5 min, 30 min, 2 h, 6 h).
MAX_ATTEMPTS=5

# Facility timezone, used for quiet hours on reminders (IANA name).
NOTIFICATION_TIMEZONE=Asia/Kolkata

# Rendered message bodies are wiped once a message is delivered (privacy); the log keeps the metadata.
# Failed ones keep their body for diagnosis. Everything older than this many days is purged by `npm run purge`.
NOTIFICATION_RETENTION_DAYS=90

# CORS — comma-separated list of allowed origins.
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4300
